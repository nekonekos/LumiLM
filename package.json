{
  "name": "lumilm",
  "productName": "LumiLM",
  "version": "0.3.0",
  "private": true,
  "description": "LumiLM - 本地大模型桌面客户端 / Local LLM desktop client powered by llama.cpp",
  "author": {
    "name": "LumiNya",
    "url": "https://luminya.cc",
    "email": "nekonekos@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/nekonekos/LumiLM",
  "repository": {
    "type": "git",
    "url": "https://github.com/nekonekos/LumiLM.git"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "prebuild": "node scripts/make-icon.mjs",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit --composite false",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit --composite false",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md,yml,mjs}\"",
    "test": "vitest run",
    "fetch:llama": "node scripts/fetch-llama-backends.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --win zip",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  }
}
